NEXT_PUBLIC_SITE_URL=https://eduwrap.com
# Validated website enquiries are delivered to this inbox using the SMTP settings below.
CONTACT_EMAIL=eduwrap0@gmail.com

# Optional comma-separated DNS resolvers for environments where local DNS blocks MongoDB Atlas SRV lookups.
MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8

# Encode reserved URI characters in database credentials (for example, @ becomes %40).
MONGODB_URI=mongodb+srv://username:encoded-password@cluster.example.mongodb.net/database?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Used only by `npm run seed:admin`; never expose these as NEXT_PUBLIC_* variables.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Server-only Cloudinary credentials used for profile images, gallery images, blog images, and course-material uploads.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Server-only SMTP settings used for registration, fee-receipt, and course-completion emails.
# Use port 465 with SMTP_SECURE=true, or port 587 with SMTP_SECURE=false.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=eduwrap123@gmail.com
SMTP_PASSWORD=lgnlvksqcofauqze
SMTP_FROM_EMAIL=eduwrap123@gmail.com
SMTP_FROM_NAME=EduWrap
